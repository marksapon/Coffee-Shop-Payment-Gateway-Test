# XENDIT Config (frontend direct — for standalone testing)
XENDIT_READ_KEY =
XENDIT_WRITE_KEY =
XENDIT_WEBHOOK_SECRET =
XENDIT_PUBLIC_KEY =

# Payment gateway routing: "frontend" = Next.js API route, "backend" = Express API
NEXT_PUBLIC_PAYMENT_GATEWAY=frontend

# Backend URL (only used when NEXT_PUBLIC_PAYMENT_GATEWAY=backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3210